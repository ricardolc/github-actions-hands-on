name: 16 - envs

on:
  workflow_dispatch:
    inputs:
      target-env:
        type: environment


jobs:  
   echo: 
      runs-on: ubuntu-latest
      environment: ${{ inputs.target-env }}
      env: 
        my-env-value: ${{ vars.MY_ENV_VALUE || 'default-value' }}

      steps:
        - name: Echo vars
          run: |
            echo "Environment Variables for: ${{ env.my-env-value }}"

